# Required to actually send consultation form submissions by email.
# Sign up at https://resend.com, verify a sending domain (or use the
# onboarding@resend.dev test sender for staging), and paste the API key here.
RESEND_API_KEY=

# Optional overrides (defaults shown are already correct for launch):
# CONTACT_TO_EMAIL=dmhrmanagementconsultancy@gmail.com
# CONTACT_FROM_EMAIL=D.M HR Consultancy Website <onboarding@resend.dev>

# Optional: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# Leave blank to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
